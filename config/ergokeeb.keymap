#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Made using: https://nickcoutsos.github.io/keymap-editor/

&lt { tapping-term-ms = <170>; };

&mt {
    tapping-term-ms = <170>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        quotes: quotes {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTES";
            bindings = <&kp SQT>, <&kp LEFT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        commas: commas {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMAS";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dquotes: dquotes {
            compatible = "zmk,behavior-mod-morph";
            label = "DQUOTES";
            bindings = <&kp DOUBLE_QUOTES>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dots: dots {
            compatible = "zmk,behavior-mod-morph";
            label = "DOTS";
            bindings = <&kp DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        qmark: qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "QMARK";
            bindings = <&kp QMARK>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E      &kp R        &kp T        &kp Y  &kp U           &kp I      &kp O    &kp P     &kp BSPC
&lt 7 ESC  &kp A  &kp S  &kp D      &kp F        &kp G        &kp H  &kp J           &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C      &kp V        &kp B        &kp N  &kp M           &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                         &kp RCTRL  &lt 8 ENTER  &kp LSHFT    &mo 7  &mt LALT SPACE  &kp RALT
            >;
        };

        engram_layer {
            bindings = <
&kp DEL              &kp B    &kp Y       &kp O        &kp U          &quotes          &dquotes               &kp L        &kp D        &kp W       &kp V    &kp BSPC
&mt LEFT_GUI ESCAPE  &lt 8 C  &mt RALT I  &mt LSHFT E  &mt LCTRL A    &commas          &dots                  &mt RCTRL H  &mt RSHFT T  &mt RALT S  &lt 8 N  &mt RGUI Q
&caps_word           &kp G    &kp X       &kp J        &kp K          &kp MINUS        &qmark                 &kp R        &kp M        &kp F       &kp P    &kp Z
                                          &lt 6 TAB    &lt (5) LC(V)  &lt (4) LC(C)    &lt (7) LC(BACKSPACE)  &kp SPACE    &lt 5 ENTER
            >;
        };

        engram_test_typing_layer {
            bindings = <
&kp DEL     &kp B  &kp Y  &kp O      &kp U          &quotes          &dquotes               &kp L      &kp D        &kp W  &kp V  &kp BSPC
&kp ESC     &kp C  &kp I  &kp E      &kp A          &commas          &dots                  &kp H      &kp T        &kp S  &kp N  &kp Q
&caps_word  &kp G  &kp X  &kp J      &kp K          &kp MINUS        &qmark                 &kp R      &kp M        &kp F  &kp P  &kp Z
                          &lt 6 TAB  &lt (5) LC(V)  &lt (4) LC(C)    &lt (7) LC(BACKSPACE)  &kp SPACE  &lt 5 ENTER
            >;
        };

        gaming_layer {
            bindings = <
&kp TAB          &kp Q  &kp W  &kp E      &kp R      &kp T        &kp Y  &kp U           &kp I      &kp O    &kp P     &kp BSPC
&mt LALT ESCAPE  &kp A  &kp S  &kp D      &kp F      &kp G        &kp H  &kp J           &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT        &kp Z  &kp X  &kp C      &kp V      &kp B        &kp N  &kp M           &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                               &kp LCTRL  &kp ENTER  &kp SPACE    &mo 7  &mt LALT SPACE  &kp RALT
            >;
        };

        navigation_layer {
            bindings = <
&trans  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &none   &none        &none       &kp PAGE_UP  &kp PAGE_DOWN  &none      &none  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none   &none        &kp LEFT    &kp DOWN     &kp UP         &kp RIGHT  &none  &trans
&trans  &none           &none           &none            &none   &none        &kp INSERT  &kp HOME     &kp END        &none      &none  &kp LALT
                                        &trans           &trans  &kp SPACE    &trans      &trans       &trans
            >;
        };

        function_layer {
            bindings = <
&trans  &kp F12  &kp F9  &kp F8  &kp F7  &none        &none          &none       &none       &none       &none       &trans
&trans  &kp F11  &kp F6  &kp F5  &kp F4  &none        &none          &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &trans
&trans  &kp F10  &kp F3  &kp F2  &kp F1  &kp SLASH    &kp BACKSLASH  &kp LG(U)   &kp LG(I)   &kp LG(O)   &kp LG(P)   &trans
                         &trans  &trans  &trans       &trans         &trans      &trans
            >;
        };

        number_layer {
            bindings = <
&trans  &kp PLUS   &kp N9  &kp N8     &kp N7     &kp STAR     &kp STAR   &kp N7     &kp N8     &kp N9  &kp PLUS   &trans
&trans  &kp MINUS  &kp N6  &kp N5     &kp N4     &kp N0       &kp N0     &kp N4     &kp N5     &kp N6  &kp MINUS  &kp TAB
&trans  &kp EQUAL  &kp N3  &kp N2     &kp N1     &kp FSLH     &kp BSLH   &kp N1     &kp N2     &kp N3  &kp EQUAL  &kp RET
                           &kp COMMA  &kp COMMA  &kp SPACE    &kp COMMA  &kp SPACE  &kp COMMA
            >;
        };

        utility_layer {
            bindings = <
&sys_reset  &bt BT_CLR       &bt BT_CLR_ALL   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2         &kp LG(F8)        &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &trans  &to 0  &sys_reset
&trans      &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &sys_reset           &kp C_PLAY_PAUSE  &kp C_PREVIOUS        &kp C_NEXT            &trans  &to 1  &kp PRINTSCREEN
&trans      &rgb_ug RGB_EFF  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &ext_power EP_TOG    &trans            &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &to 3  &to 2
                                              &bootloader      &trans           &trans               &trans            &trans                &bootloader
            >;
        };

        symbol_layers {
            bindings = <
&kp TILDE     &kp GRAVE      &trans         &trans        &trans         &kp LS(LT)      &kp LS(GT)    &kp LS(LT)    &kp LS(GT)    &trans  &trans  &trans
&kp LS(PIPE)  &kp LS(EXCL)   &kp LS(AT)     &kp LS(DLLR)  &kp LS(POUND)  &kp LS(LBRC)    &kp LS(RBRC)  &kp LS(LBRC)  &kp LS(RBRC)  &trans  &trans  &trans
&trans        &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)   &kp LBKT        &kp RBKT      &kp LBKT      &kp RBKT      &trans  &trans  &trans
                                            &trans        &trans         &trans          &trans        &trans        &trans
            >;
        };
    };
};
