#include "ergokeeb.dtsi"

&kscan0 {
    row-gpios
        = <&pro_micro 3 GPIO_ACTIVE_HIGH> // P0.20 - D3
        , <&pro_micro 4 GPIO_ACTIVE_HIGH> // P0.22 - D4
        , <&pro_micro 5 GPIO_ACTIVE_HIGH> // P0.24 - D5                                                                                                                                                                                                                                                                                                                             
        , <&pro_micro 6 GPIO_ACTIVE_HIGH> // P1.00 - D6
        ;

    col-gpios
        = <&pro_micro 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)> // P0.17 - D2
        , <&pro_micro 14 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)> // P1.11 - D14
        , <&pro_micro 15 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)> // P1.13 - D15
        , <&pro_micro 18 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)> // P1.15 - D18
        , <&pro_micro 19 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)> // P0.02 - D19
        , <&pro_micro 20 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)> // P0.29 - D20
        ;
};

&default_transform0 { // Offset of 6 because the left side has 6 columns
    col-offset = <6>;
};