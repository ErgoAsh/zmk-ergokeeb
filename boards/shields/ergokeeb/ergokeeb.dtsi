#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };
    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        
        chain-length = <21>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform0;
        zmk,underglow = &led_strip;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";
    };

    default_transform0: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        //      | SW0  | SW1  | SW2  | SW3  | SW4  | SW5  |                  | SW6  | SW7  | SW8  | SW9  | SW10 | SW11 |
        //      | SW12 | SW13 | SW14 | SW15 | SW16 | SW17 |                  | SW18 | SW19 | SW20 | SW21 | SW22 | SW23 |
        //      | SW24 | SW25 | SW26 | SW27 | SW28 | SW29 |                  | SW30 | SW31 | SW32 | SW33 | SW34 | SW35 |
        //                           | SW36 | SW37 | SW38 |                  | SW39 | SW40 | SW41 |
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                  RC(0,6) RC(0,7) RC(0,8)  RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                  RC(1,6) RC(1,7) RC(1,8)  RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                  RC(2,6) RC(2,7) RC(2,8)  RC(2,9) RC(2,10) RC(2,11)
                                    RC(3,3) RC(3,4) RC(3,1)                  RC(3,10) RC(3,7) RC(3,8)
        >;
        // Jumper from main board to thumb cluster contains pins C5, C4, R3, C2 and not C6, thus the strange config of SW38 and SW39
    };
};
